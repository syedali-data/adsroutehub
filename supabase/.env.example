# Resend Email Configuration
# Use a PRODUCTION key (not re_test_...) to send emails to external recipients
# Get your production key from: https://resend.com/api-keys
RESEND_API_KEY=

# Optional: For local development only
# When set to 'true', allows test keys to be used (emails will still be sent to real addresses)
# Default: false (production behavior - rejects test keys)
ALLOW_TEST_SEND_TO_OWNER=false

# Lead Intake API Key
# Used to authenticate lead intake requests
LEAD_INTAKE_API_KEY=

# Twilio SMS Configuration (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
